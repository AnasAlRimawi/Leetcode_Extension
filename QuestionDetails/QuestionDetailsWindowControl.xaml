<UserControl x:Class="VSIXProject2.QuestionDetails.QuestionDetailsWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VSIXProject2.QuestionDetails"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row for Title -->
            <RowDefinition Height="*"/>
            <!-- Row for HtmlViewer -->
            <RowDefinition Height="Auto"/>
            <!-- Row for Buttons -->
        </Grid.RowDefinitions>

        <!-- Title Row -->
        <TextBlock  x:Name="TitleTextBlock"
               Grid.Row="0" 
               Text="Question Title" 
               FontSize="40" 
               FontWeight="Bold"
               Foreground="#877cb2"
               Margin="10" />

        <!-- Web Browser Row -->
        <WebBrowser x:Name="HtmlViewer" Grid.Row="1" Margin="10"/>
        <StackPanel 
        Grid.Row="2" 
        Orientation="Horizontal" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Margin="10">

            <Button 
            Content="Start" 
            Margin="5" 
            Width="100" 
            Height="40"
            Foreground="White"
            Background="#333"
            BorderThickness="0"
            Click="Start_Question"/>


            <Button 
            Content="Run" 
            Margin="5" 
            Width="100" 
            Height="40"
            Foreground="White"
            BorderThickness="0"
            Background="#333"
            Click="Test_Question"
            />


            <Button 
            Content="Submit" 
            Margin="5" 
            Width="100" 
            Height="40"
            Foreground="White"
            BorderThickness="0"
            Background="#333"
            Click="Submit_Question"
            />


        </StackPanel>
    </Grid>

</UserControl>
    
