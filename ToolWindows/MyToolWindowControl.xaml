<UserControl x:Class="VSIXProject2.MyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VSIXProject2"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="container">
            <TextBlock Text="leetcodesession" TextAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            <TextBox Name="leetcodesession" Text="{Binding LeetcodeSession, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,10" />

            <TextBlock Text="csrftoken" TextAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            <TextBox Name="csrftoken" Text="{Binding CsrfToken, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,10" />
        </StackPanel>


    </ScrollViewer>
</UserControl>

